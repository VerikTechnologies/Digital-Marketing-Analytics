{
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "digital-marketing-analytics.railway.internal/api/:match*"
    },
    {
      "source": "/qr/:match*",
      "destination": "digital-marketing-analytics.railway.internal/qr/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
