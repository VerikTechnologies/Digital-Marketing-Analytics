generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model audit_logs {
  id            BigInt   @id @default(autoincrement())
  admin_user_id String?  @db.Uuid
  action        String   @db.VarChar(100)
  entity_type   String   @db.VarChar(100)
  entity_id     BigInt?
  details       Json?
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at(sort: Desc)], map: "idx_audit_created")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model brands {
  id          BigInt      @id @default(autoincrement())
  name        String      @db.VarChar(150)
  slug        String      @unique @db.VarChar(120)
  website_url String?
  logo_url    String?
  active      Boolean     @default(true)
  created_at  DateTime    @default(now()) @db.Timestamptz(6)
  updated_at  DateTime    @default(now()) @db.Timestamptz(6)
  fb_pixel_id String?     @db.VarChar(50)
  ga_id       String?     @db.VarChar(50)
  campaigns   campaigns[]
  qrs         qrs[]

  @@index([created_at(sort: Desc)], map: "idx_brands_created")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model campaigns {
  id            BigInt    @id @default(autoincrement())
  brand_id      BigInt
  name          String    @db.VarChar(200)
  slug          String    @db.VarChar(150)
  campaign_type String?   @default("") @db.VarChar(100)
  start_date    DateTime? @db.Date
  end_date      DateTime? @db.Date
  budget        Decimal?  @db.Decimal(12, 2)
  status        String    @default("active")
  notes         String?
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @db.Timestamptz(6)
  brands        brands    @relation(fields: [brand_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  qrs           qrs[]

  @@unique([brand_id, slug])
  @@index([start_date, end_date], map: "idx_campaign_dates")
  @@index([status], map: "idx_campaign_status")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model destinations {
  id             BigInt    @id @default(autoincrement())
  qr_id          BigInt
  website_url    String
  android_url    String?
  ios_url        String?
  utm_source     String?   @default("") @db.VarChar(150)
  utm_medium     String?   @default("") @db.VarChar(150)
  utm_campaign   String?   @default("") @db.VarChar(150)
  utm_content    String?   @default("") @db.VarChar(150)
  utm_term       String?   @default("") @db.VarChar(150)
  effective_from DateTime  @default(now()) @db.Timestamptz(6)
  effective_to   DateTime? @db.Timestamptz(6)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  fb_pixel_id    String?   @db.VarChar(50)
  ga_id          String?   @db.VarChar(50)
  qrs            qrs       @relation(fields: [qr_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  scans          scans[]

  @@index([qr_id, effective_from, effective_to], map: "idx_destination_qr")
  @@index([qr_id], map: "idx_destinations_qr_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model qrs {
  id           BigInt         @id @default(autoincrement())
  brand_id     BigInt
  campaign_id  BigInt
  name         String         @db.VarChar(200)
  code         String         @unique @db.VarChar(100)
  channel      String?        @default("") @db.VarChar(100)
  location     String?        @default("") @db.VarChar(150)
  active       Boolean        @default(true)
  created_at   DateTime       @default(now()) @db.Timestamptz(6)
  updated_at   DateTime       @default(now()) @db.Timestamptz(6)
  destinations destinations[]
  brands       brands         @relation(fields: [brand_id], references: [id], onUpdate: NoAction)
  campaigns    campaigns      @relation(fields: [campaign_id], references: [id], onUpdate: NoAction)
  scans        scans[]

  @@index([active], map: "idx_qr_active")
  @@index([brand_id], map: "idx_qr_brand")
  @@index([campaign_id], map: "idx_qr_campaign")
  @@index([code], map: "idx_qrs_code")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model scans {
  id               BigInt        @id @default(autoincrement())
  qr_id            BigInt
  destination_id   BigInt?
  scanned_at       DateTime      @default(now()) @db.Timestamptz(6)
  ip_hash          String?       @db.Char(64)
  country          String?       @db.VarChar(100)
  city             String?       @db.VarChar(100)
  browser          String?       @db.VarChar(100)
  browser_version  String?       @db.VarChar(50)
  os               String?       @db.VarChar(100)
  os_version       String?       @db.VarChar(50)
  device           String?       @db.VarChar(100)
  device_type      String?       @db.VarChar(30)
  referrer         String?
  user_agent       String?
  destination_type String        @default("website") @db.VarChar(20)
  destinations     destinations? @relation(fields: [destination_id], references: [id], onUpdate: NoAction)
  qrs              qrs           @relation(fields: [qr_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([city], map: "idx_scan_city")
  @@index([country], map: "idx_scan_country")
  @@index([scanned_at], map: "idx_scan_date")
  @@index([qr_id, scanned_at], map: "idx_scan_qr_date")
  @@index([qr_id], map: "idx_scans_qr_id")
}
